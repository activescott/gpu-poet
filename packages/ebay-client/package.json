{
  "name": "@activescott/ebay-client",
  "type": "module",
  "version": "1.0.0",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./categories/US_EBAY": "./src/categories/EBAY_US.ts"
  },
  "types": "src/index.ts",
  "files": [
    "dist/",
    "!dist/cjs/",
    "!**/*.test.js",
    "!**/*.test.d.ts",
    "!**/__mocks__/"
  ],
  "author": {
    "name": "Scott Willeke",
    "email": "scott@willeke.com",
    "url": "https://scott.willeke.com/"
  },
  "scripts": {
    "eslint": "eslint . --ext ts,tsx,js,jsx",
    "lint": "prettier -l \"{,!(node_modules)/**/}*.{ts,tsx,md,yml,json,html}\" && npm run eslint",
    "lint-fix": "prettier --write \"{,!(node_modules)/**/}*.{ts,tsx,md,yml,json,html}\" && npm run eslint --fix",
    "typecheck": "tsc --noEmit --project tsconfig.es.json",
    "build:es": "rm -rf ./dist/es; npx tsc --project tsconfig.es.json",
    "dev": "rm -rf ./dist/es; npx tsc --project tsconfig.es.json --watch",
    "build": "rm -rf ./dist && npm run build:es",
    "test-watch": "npx jest --watch",
    "clean": "rm -rf node_modules; rm -rf dist ; rm -rf .turbo",
    "test": "npx jest"
  },
  "keywords": [
    "ebay",
    "client",
    "api",
    "sdk",
    "rest",
    "ebay-api",
    "ebay-sdk",
    "ebay-rest",
    "ebay-client"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@activescott/eslint-config": "^3.0.0",
    "@types/async-retry": "^1.4.9",
    "@types/jest": "^29.5.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.9.4",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "irritable-iterable": "^1.3.1",
    "lodash-es": "^4.17.21",
    "pino": "^9.6.0",
    "type-fest": "^4.8.2"
  }
}
